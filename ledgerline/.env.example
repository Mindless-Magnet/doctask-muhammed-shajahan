LEDGERLINE_DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@localhost:5432/ledgerline

# replay is the default and needs no credentials. 'record' captures fixtures from live Bedrock,
# 'bedrock' runs live, 'faulty' injects failures for the degradation tests.
LEDGERLINE_MODEL_CLIENT=replay
LEDGERLINE_AWS_REGION=us-east-1

# Three tiers, cheapest first. The judge tier (DEEP) is a separate call with a separate prompt that
# never sees the value it is checking. Cross-family verification was the goal and Bedrock would not
# allow it: Llama 4 Maverick and Pixtral Large both reject forced tool use, and Nova Premier is
# marked legacy. See config.py and the "Where this build is weak" section of the README.
LEDGERLINE_MODEL_CHEAP=us.amazon.nova-lite-v1:0
LEDGERLINE_MODEL_STANDARD=us.amazon.nova-pro-v1:0
LEDGERLINE_MODEL_DEEP=us.amazon.nova-2-lite-v1:0

# The review interface reads this at build time. Local display token only.
LEDGERLINE_API_TOKEN=dev-token
