LEDGERLINE_DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@localhost:5432/ledgerline

# replay is the default and needs no credentials. 'record' captures fixtures from live Bedrock,
# 'bedrock' runs live, 'faulty' injects failures for the degradation tests.
LEDGERLINE_MODEL_CLIENT=replay
LEDGERLINE_AWS_REGION=us-east-1

# Extraction runs on Nova; the judge runs on Llama on purpose. See config.py.
LEDGERLINE_MODEL_CHEAP=us.amazon.nova-lite-v1:0
LEDGERLINE_MODEL_STANDARD=us.amazon.nova-pro-v1:0
LEDGERLINE_MODEL_DEEP=us.meta.llama4-maverick-17b-instruct-v1:0
